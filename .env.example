APP_NAME="HealthyLife AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=healthylife_ai
DB_USERNAME=root
DB_PASSWORD=

# Web dashboard origin — password-reset e-mails link into it
# (`/{locale}/reset-password`). Set to the deployed frontend URL in production.
FRONTEND_URL=http://localhost:3000

# "Continue with Google" — the OAuth web client id from Google Cloud Console
# (APIs & Services → Credentials). The same value goes in the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave blank to keep Google sign-in disabled;
# the API then answers 503 for POST /auth/google.
GOOGLE_CLIENT_ID=

# Access token lifetime in minutes (spec: short-lived, 15 min) and refresh
# token lifetime in minutes (spec: 30 days). JWT_SECRET must be a distinct
# secret per environment — never reuse APP_KEY, generate with `php artisan jwt:secret`.
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=43200

# S3-06 / F-5 (PRD, P1) optional upgrade: AI-drafted plans use a real LLM
# call when this is set, falling back to the rule-based generator that
# shipped with S3-06 when it isn't (see config/ai.php and
# AiDraftPlanService) — leave OPENAI_API_KEY blank to stay rule-based,
# e.g. in CI. Any OpenAI-compatible endpoint works; the values below are
# Groq's free tier (console.groq.com), not a hardcoded dependency on it.
# Groq retires/renames models over time — a bad OPENAI_MODEL fails
# closed (caught, logged, falls back to rule-based) rather than erroring,
# so a stale name here is silent. Confirm current names against
# GET https://api.groq.com/openai/v1/models before assuming this is wrong.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_TIMEOUT=12

# S5-03/S5-04 (optional): a SEPARATE key for the weekly-summary job, so it
# doesn't share Sprint 3's Groq quota with the AI draft feature above —
# both hitting one free-tier rate limit made a draft's fallback-to-
# rule-based depend on whether the weekly job happened to run recently.
# Every var here falls back to the corresponding OPENAI_* one above when
# left blank, so this is purely additive — a second free Groq account (or
# any other OpenAI-compatible provider) works fine.
OPENAI_SUMMARY_BASE_URL=
OPENAI_SUMMARY_API_KEY=
OPENAI_SUMMARY_MODEL=
OPENAI_SUMMARY_TIMEOUT=

# S5-06 / FR-22: push notifications via Firebase Cloud Messaging. Three
# ways to supply the service-account JSON from Firebase console (Project
# settings → Service accounts → Generate new private key):
#   - FIREBASE_CREDENTIALS_JSON_BASE64: the file's content, base64-
#     encoded, one line — SET THIS ON TAQAT/DOKKU OR ANY PAAS DASHBOARD.
#     Not a theoretical precaution: setting the raw JSON directly as
#     FIREBASE_CREDENTIALS_JSON on this project's own Taqat deployment
#     broke login/register outright — the JSON's unescaped `"` characters
#     corrupted Taqat's own env-var storage before the app ever got a
#     chance to log an exception. Base64 output is exactly
#     [A-Za-z0-9+/=], nothing an env-var store could misinterpret.
#   - FIREBASE_CREDENTIALS_JSON: the raw file content, no encoding. Only
#     use this if you've confirmed your specific host passes env vars
#     through untouched — prefer the base64 form otherwise.
#   - FIREBASE_CREDENTIALS_PATH: a file on local disk — for local dev
#     only, where the file genuinely sits on the same machine.
# Precedence: base64 > raw json > path. Leave all three blank to stay
# silent: FcmPushService and the reminder job both fail closed, same
# pattern as leaving OPENAI_API_KEY blank.
FIREBASE_CREDENTIALS_JSON_BASE64=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Scheduled jobs (alerts 06:00, reminders 20:00, weekly AI summary Mon 07:00)
# run without cron: overdue ones run after the next request. See DEPLOYMENT.md.
SCHEDULE_TIMEZONE=Asia/Riyadh
SCHEDULE_SELF_TRIGGER=true

# Patient app: how long a patient can edit/delete their own log after its date
# (BR-15) and how far back a new entry may be dated (BR-19). See config/patient_app.php.
LOG_EDIT_WINDOW_HOURS=48
LOG_BACKDATE_LIMIT_DAYS=7

# Admin panel account, created by `db:seed` when both are set (no default is shipped).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="HealthyLife Admin"

# Demo login nutritionist@example.com. `db:seed` creates it only when this is
# set, or on APP_ENV=local (random password, printed once). Leave empty in production.
DEMO_NUTRITIONIST_PASSWORD=
